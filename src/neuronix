    print(f'  Target File     : {res[\"target_file\"]}')
    print(f'  Packages Added  : {\", \".join(res[\"packages_added\"])}')
    print('  Stage new generation with: neuronix upgrade --staged')
elif res.get('status') == 'noop':
    print('\033[38;5;51mℹ\033[0m ' + res['message'])
else:
