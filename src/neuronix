# Main CLI Dispatcher
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local cmd="${1:-}"
    shift || true

    case "${cmd}" in
        status)
            cmd_status "$@"
            ;;
        diet)
            cmd_diet "$@"
            ;;
        check-update|check)
            cmd_check_update "$@"
            ;;
        upgrade|update)
            cmd_upgrade "$@"
            ;;
        run)
            cmd_run "$@"
            ;;
        dev)
            cmd_dev "$@"
            ;;
        try)
            cmd_try "$@"
            ;;
        verify)
            cmd_verify "$@"
            ;;
        shield|oom)
            cmd_shield "$@"
            ;;
        generations|list)
            cmd_generations "$@"
            ;;
        battery)
            cmd_battery "$@"
            ;;
        center)
            cmd_center "$@"
            ;;
        mcp)
            cmd_mcp "$@"
            ;;
        undo|rollback)
            cmd_undo "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        welcome)
            cmd_welcome "$@"
            ;;
        quickstart|apps)
            cmd_quickstart "$@"
            ;;
        kernel)
            cmd_kernel "$@"
            ;;
        manual|man|docs)
            cmd_manual "$@"
            ;;
        version|-v|--version)
            cmd_version
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            log_error "Command '${cmd}' is unrecognized (tidak dikenali)."
            echo -e "Run '${CYAN}${PROGRAM_NAME} help${RESET}' to view available commands."
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
