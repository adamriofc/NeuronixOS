    print(f'    \033[38;5;82m+ {sample}\033[0m')
print(f'  User Executables Removed : -{len(removed)}')
if removed:
    sample = \", \".join(removed[:10]) + ('...' if len(removed) > 10 else '')
    print(f'    \033[38;5;196m- {sample}\033[0m')
svc_added = diff.get('services_added', [])
