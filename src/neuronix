    local selected_tier="${explicit_tier:-}"

    # Negotiate domain specification safely without string injection
    local hds_json=""
    if [[ -n "$py_bin" && -n "$core_path" ]]; then
        hds_json="$(PYTHONPATH="$core_path" "$py_bin" -c '
