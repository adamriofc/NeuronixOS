dry_run = sys.argv[1] == '1'
json_out = sys.argv[2] == '1'
force = sys.argv[3] == '1'
pkgs = sys.argv[4:]

res = distill_packages(pkgs, dry_run=dry_run, force=force)

if json_out:
    print(json.dumps(res, indent=2))
