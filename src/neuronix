}

# Main CLI Dispatcher
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local cmd="${1:-}"
    shift || true

    case "${cmd}" in
        state)
            cmd_state "$@"
            ;;
        hyperion)
            cmd_hyperion "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        diet)
            cmd_diet "$@"
            ;;
        check-update|check)
            cmd_check_update "$@"
            ;;
        upgrade|update)
            cmd_upgrade "$@"
            ;;
        run)
            cmd_run "$@"
            ;;
        dev)
            cmd_dev "$@"
            ;;
        try)
            cmd_try "$@"
            ;;
        verify)
            cmd_verify "$@"
            ;;
        shield|oom)
            cmd_shield "$@"
            ;;
        generations|list)
            cmd_generations "$@"
            ;;
        battery)
            cmd_battery "$@"
            ;;
        center)
            cmd_center "$@"
            ;;
        mcp)
            cmd_mcp "$@"
            ;;
        undo|rollback)
            cmd_undo "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        verify-passport|verify-release)
            local py_bin="$(resolve_python)"
            local verify_script="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/tools/verify_passport.py"
            if [[ -f "$verify_script" && -n "$py_bin" ]]; then
                "$py_bin" "$verify_script" "$@"
                exit $?
            else
                log_error "Offline verifier script not found at $verify_script"
                exit 1
            fi
            ;;
        graph)
            local py_bin="$(resolve_python)"
            local verify_script="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/tools/verify_passport.py"
            if [[ -f "$verify_script" && -n "$py_bin" ]]; then
                "$py_bin" "$verify_script" --graph "$@"
                exit $?
            else
                log_error "Offline verifier script not found at $verify_script"
                exit 1
            fi
            ;;
        welcome)
            cmd_welcome "$@"
            ;;
        quickstart|apps)
            cmd_quickstart "$@"
            ;;
        kernel)
            cmd_kernel "$@"
            ;;
        manual|man|docs)
            cmd_manual "$@"
            ;;
        sentinel)
            cmd_sentinel "$@"
            ;;
        diff)
            cmd_diff "$@"
            ;;
        distill)
            cmd_distill "$@"
            ;;
        container)
            cmd_container "$@"
            ;;
        sandbox)
            cmd_sandbox "$@"
            ;;
        tune)
            cmd_tune "$@"
            ;;
        mesh)
            cmd_mesh "$@"
            ;;
        daemon)
            cmd_daemon "$@"
            ;;
        ghost)
            cmd_ghost "$@"
            ;;
        branch)
            cmd_branch "$@"
            ;;
        ebpf)
            cmd_ebpf "$@"
            ;;
        version|-v|--version)
            cmd_version
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            log_error "Command '${cmd}' is unrecognized (tidak dikenali)."
            echo -e "Run '${CYAN}${PROGRAM_NAME} help${RESET}' to view available commands."
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
