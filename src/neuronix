# Concurrency Lock Gatekeeper (flock)
LOCK_FD=200
LOCK_FILE=""

acquire_lock() {
    local op_name="${1:-operation}"
    local lock_dir="/run"
    if [[ ! -d "$lock_dir" || ! -w "$lock_dir" ]]; then
        lock_dir="/tmp"
    fi
    LOCK_FILE="${lock_dir}/neuronix-operation.lock"

    exec 200>"$LOCK_FILE"
    if ! flock -n 200; then
        log_warn "Another NEURONIX system operation is currently running. Waiting for lock..."
        if ! flock -w 30 200; then
            log_error "Could not acquire system operation lock (${LOCK_FILE}). Aborting."
            exit 1
        fi
    fi
}

release_lock() {
    if [[ -n "${LOCK_FILE:-}" ]]; then
        flock -u 200 2>/dev/null || true
    fi
}

trap release_lock EXIT INT TERM

# Privileged Command Allow-List Gatekeeper
run_privileged() {
    local cmd="$1"
    shift
    case "$cmd" in
        nixos-rebuild|nix-collect-garbage|nix-store|journalctl|fstrim|tee|mkdir)
            ;;
        *)
            log_error "Privileged execution denied: '${cmd}' is not in the security allow-list."
            return 1
            ;;
    esac

    if [[ "$EUID" -eq 0 ]]; then
        "$cmd" "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$cmd" "$@"
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$cmd" "$@"
    else
        log_error "Privilege escalation utility (sudo or pkexec) not found in system."
        return 1
    fi
}

