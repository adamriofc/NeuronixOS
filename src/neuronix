set -eo pipefail

# Safe Path & Environment Fallbacks (Mission-critical defensive posture)
export PATH="/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/bin:/bin:${PATH:-}"
if [[ -z "${NIX_REMOTE:-}" && -S "/nix/var/nix/daemon-socket/socket" ]]; then
    export NIX_REMOTE="daemon"
fi

VERSION="1.0.5"
VERSION_NIX="$(dirname "$(readlink -f "$0")")/../version.nix"
if [[ -n "${PROJECT_ROOT:-}" && -f "${PROJECT_ROOT}/version.nix" ]]; then
    VERSION_NIX="${PROJECT_ROOT}/version.nix"
elif [[ ! -f "$VERSION_NIX" && -f "$(dirname "$(readlink -f "$0")")/../share/neuronix/version.nix" ]]; then
    VERSION_NIX="$(dirname "$(readlink -f "$0")")/../share/neuronix/version.nix"
elif [[ ! -f "$VERSION_NIX" && -f "/etc/neuronix/version.nix" ]]; then
    VERSION_NIX="/etc/neuronix/version.nix"
fi
if [[ -f "$VERSION_NIX" ]]; then
    VERSION=$(grep -E 'version\s*=' "$VERSION_NIX" | head -n 1 | sed -E 's/.*"([^"]+)".*/\1/')
fi
PROGRAM_NAME="neuronix"

# Resolve module library and command paths dynamically
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
if [[ ! -d "${SCRIPT_DIR}/lib" ]]; then
    if [[ -n "${PROJECT_ROOT:-}" && -d "${PROJECT_ROOT}/src/lib" ]]; then
        SCRIPT_DIR="${PROJECT_ROOT}/src"
    elif [[ -d "$(pwd)/src/lib" ]]; then
        SCRIPT_DIR="$(pwd)/src"
    elif [[ -d "/run/current-system/sw/share/neuronix/lib" ]]; then
        SCRIPT_DIR="/run/current-system/sw/share/neuronix"
    elif [[ -d "/etc/neuronix/lib" ]]; then
        SCRIPT_DIR="/etc/neuronix"
    fi
fi

# Load shared core libraries
source "${SCRIPT_DIR}/lib/color.sh"
source "${SCRIPT_DIR}/lib/banner.sh"
# Concurrency locking mechanism via flock (acquire_lock, release_lock)
source "${SCRIPT_DIR}/lib/lock.sh"
source "${SCRIPT_DIR}/lib/version.sh"
source "${SCRIPT_DIR}/lib/validation.sh"

# Load modular command handlers
source "${SCRIPT_DIR}/commands/help.sh"
source "${SCRIPT_DIR}/commands/status.sh"
source "${SCRIPT_DIR}/commands/diet.sh"
source "${SCRIPT_DIR}/commands/sandbox.sh"
source "${SCRIPT_DIR}/commands/dev.sh"
source "${SCRIPT_DIR}/commands/mcp.sh"
source "${SCRIPT_DIR}/commands/generations.sh"
source "${SCRIPT_DIR}/commands/system.sh"
source "${SCRIPT_DIR}/commands/doctor.sh"
source "${SCRIPT_DIR}/commands/distro.sh"
source "${SCRIPT_DIR}/commands/diff.sh"
source "${SCRIPT_DIR}/commands/distill.sh"
source "${SCRIPT_DIR}/commands/container.sh"
source "${SCRIPT_DIR}/commands/tune.sh"
source "${SCRIPT_DIR}/commands/mesh.sh"
source "${SCRIPT_DIR}/commands/daemon.sh"
source "${SCRIPT_DIR}/commands/ghost.sh"
source "${SCRIPT_DIR}/commands/branch.sh"
source "${SCRIPT_DIR}/commands/ebpf.sh"
source "${SCRIPT_DIR}/commands/state.sh"
source "${SCRIPT_DIR}/commands/version.sh"
source "${SCRIPT_DIR}/commands/update.sh"
source "${SCRIPT_DIR}/commands/rollback.sh"
source "${SCRIPT_DIR}/commands/install.sh"

trap release_lock EXIT INT TERM

# Privileged Command Allow-List Gatekeeper
run_privileged() {
    local cmd="$1"
    shift
    case "$cmd" in
        # journalctl --vacuum-size=500M (delegated to commands/diet.sh)
        nixos-rebuild|nix-collect-garbage|nix-store|journalctl|fstrim|tee|mkdir)
            ;;
        *)
            log_error "Privileged execution denied: '${cmd}' is not in the security allow-list."
            return 1
            ;;
    esac

    if [[ "$EUID" -eq 0 ]]; then
        "$cmd" "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$cmd" "$@"
    elif command -v pkexec >/dev/null 2>&1; then
        pkexec "$cmd" "$@"
    else
        log_error "Privilege escalation utility (sudo or pkexec) not found in system."
        return 1
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local cmd="${1:-}"
    shift || true

    case "${cmd}" in
        state)
            cmd_state "$@"
            ;;
        hyperion)
            cmd_hyperion "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        diet|gc|clean)
            cmd_diet "$@"
            ;;
        check-update|check)
            cmd_check_update "$@"
            ;;
        upgrade|update)
            cmd_upgrade "$@"
            ;;
        run|exec)
            cmd_run "$@"
            ;;
        dev)
            cmd_dev "$@"
            ;;
        try)
            cmd_try "$@"
            ;;
        verify)
            cmd_verify "$@"
            ;;
        shield|sec|security|oom)
            cmd_shield "$@"
            ;;
        generations|history|list)
            cmd_generations "$@"
            ;;
        battery|power)
            cmd_battery "$@"
            ;;
        center|gui)
            cmd_center "$@"
            ;;
        mcp)
            cmd_mcp "$@"
            ;;
        undo|rollback)
            cmd_undo "$@"
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        verify-passport|verify-release)
            local py_bin="$(resolve_python)"
            local verify_script="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/tools/verify_passport.py"
            if [[ -f "$verify_script" && -n "$py_bin" ]]; then
                "$py_bin" "$verify_script" "$@"
                exit $?
            else
                log_error "Offline verifier script not found at $verify_script"
                exit 1
            fi
            ;;
        graph)
            local py_bin="$(resolve_python)"
            local verify_script="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/tools/verify_passport.py"
            if [[ -f "$verify_script" && -n "$py_bin" ]]; then
                "$py_bin" "$verify_script" --graph "$@"
                exit $?
            else
                log_error "Offline verifier script not found at $verify_script"
                exit 1
            fi
            ;;
        welcome)
            cmd_welcome "$@"
            ;;
        quickstart|apps)
            cmd_quickstart "$@"
            ;;
        kernel)
            cmd_kernel "$@"
            ;;
        manual|man|docs)
            cmd_manual "$@"
            ;;
        sentinel)
            cmd_sentinel "$@"
            ;;
        diff)
            cmd_diff "$@"
            ;;
        distill)
            cmd_distill "$@"
            ;;
        container)
            cmd_container "$@"
            ;;
        sandbox)
            cmd_sandbox "$@"
            ;;
        tune)
            cmd_tune "$@"
            ;;
        mesh)
            cmd_mesh "$@"
            ;;
        daemon)
            cmd_daemon "$@"
            ;;
        ghost)
            cmd_ghost "$@"
            ;;
        branch)
            cmd_branch "$@"
            ;;
        ebpf)
            cmd_ebpf "$@"
            ;;
        facter)
            cmd_facter "$@"
            ;;
        topology)
            cmd_topology "$@"
            ;;
        storage)
            cmd_storage "$@"
            ;;
        secret)
            cmd_secret "$@"
            ;;
        boot)
            cmd_boot "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        version|-v|--version)
            cmd_version
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            log_error "Command '${cmd}' is unrecognized (tidak dikenali)."
            echo -e "Run '${CYAN}${PROGRAM_NAME} help${RESET}' to view available commands."
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
