            echo -e "${BOLD}================================================================${RESET}"
            echo -e "  [VERIFY:BOOT]       PCR 7 + PCR 11 Hardware Attestation ... ${GREEN}PASS${RESET}"
            echo -e "  [VERIFY:CLOSURE]    Nix Store Pure Derivation Match       ... ${GREEN}PASS${RESET}"
