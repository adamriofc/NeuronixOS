  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
            ;;
        1)
            # Tier 1: Volatile RAM Ghost overlay
            cmd_ghost "${cmd_args[@]}" || exec_status=$?
            local nonce="nrx_nonce_t1_${$}_${RANDOM}"
            cat << EOF > "$receipt_file"
