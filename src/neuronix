print(f'  \033[1mNEURONIX 3-TIER GENERATIONAL FORENSIC DIFF\033[0m')
print('\033[1m================================================================\033[0m')
print('\033[1m[Tier 1: Generation & Kernel Metadata]\033[0m')
print(f'  Base Target A    : {diff[\"target_a\"][\"name\"]}')
print(f'  Compare Target B : {diff[\"target_b\"][\"name\"]}')
