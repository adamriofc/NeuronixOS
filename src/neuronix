  "backend": "host_direct",
  "boundary_id": "boundary-t0-$$",
  "execution_backend": "host_direct",
  "execution_nonce": "${nonce}",
  "exit_code": ${exec_status},
  "guest_boot_identity": "host-pid-$$",
