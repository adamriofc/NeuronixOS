        rm -f "$receipt_file" 2>/dev/null || true
    fi

    # Synthesize Domain Proof if requested (Fail-Closed on error)
    if [[ $gen_proof -eq 1 ]]; then
        local proof_json=""
        local proof_err=0
        if [[ -n "$py_bin" && -n "$core_path" ]]; then
            proof_json="$(printf '%s' "$hds_json" | PYTHONPATH="$core_path" "$py_bin" -c '
import json, sys
