{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronix.org/schemas/control_protocol_v1.json",
  "title": "NEURONIX Conductor Control Protocol Schema v1",
  "description": "Wire format schema for the Conductor Control Protocol (JSON-RPC 2.0) over UNIX domain socket ($XDG_RUNTIME_DIR/conductor.sock).",
  "oneOf": [
    { "$ref": "#/$defs/RequestFrame" },
    { "$ref": "#/$defs/ResponseFrame" },
    { "$ref": "#/$defs/ErrorFrame" },
    { "$ref": "#/$defs/NotificationFrame" }
  ],
  "$defs": {
    "RequestId": {
      "type": ["string", "integer"]
    },
    "RpcMethod": {
      "type": "string",
      "description": "Canonical Conductor JSON-RPC 2.0 methods: conductor.ping (liveness check), conductor.version (semantic version), vital.snapshot (full telemetry snapshot), vital.subscribe (continuous laboratory event stream), vital.unsubscribe (terminate event stream), skills.list (enumerate registered capability registry), skills.describe (detailed input schema and contract), skills.invoke (execute capability under sovereign authority), identity.resolve (verify cryptographic peer identity and role), authority.grant (issue sovereign time-bounded delegation grant), authority.revoke (immediate revocation of delegation token), proposal.resolve (human-sovereign approval or rejection of pending mutation proposal), surface.state (query minimalist operating canvas and lifecycle state).",
      "enum": [
        "conductor.ping",
        "conductor.version",
        "vital.snapshot",
        "vital.subscribe",
        "vital.unsubscribe",
        "skills.list",
        "skills.describe",
        "skills.invoke",
        "identity.resolve",
        "authority.grant",
        "authority.revoke",
        "proposal.resolve",
        "surface.state"
      ]
    },
    "RequestFrame": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "$ref": "#/$defs/RpcMethod"
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ResponseFrame": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": ["string", "integer", "null"]
        },
        "result": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false
    },
    "ErrorObject": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false
    },
    "ErrorFrame": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": ["string", "integer", "null"]
        },
        "error": {
          "$ref": "#/$defs/ErrorObject"
        }
      },
      "additionalProperties": false
    },
    "NotificationFrame": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "not": {
        "required": ["id"]
      },
      "additionalProperties": false
    }
  }
}
