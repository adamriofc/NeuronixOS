{
  "schema_version": "1.1.0",
  "standard": "RFC 8785 JSON Canonicalization Scheme (JCS)",
  "description": "Authoritative byte-for-byte conformance vectors for ECMAScript 5.1 numbers, key ordering, UTF-16 surrogate ordering, supplementary Unicode, and string escaping",
  "vectors": [
    {
      "id": "exp_threshold_1e_m6",
      "category": "exponent_threshold",
      "input": 0.000001,
      "expected_jcs": "0.000001"
    },
    {
      "id": "exp_threshold_1e_m7",
      "category": "exponent_threshold",
      "input": 0.0000001,
      "expected_jcs": "1e-7"
    },
    {
      "id": "exp_threshold_1e_20",
      "category": "exponent_threshold",
      "input": 1e20,
      "expected_jcs": "100000000000000000000"
    },
    {
      "id": "exp_threshold_1e_21",
      "category": "exponent_threshold",
      "input": 1e21,
      "expected_jcs": "1e+21"
    },
    {
      "id": "signed_negative_zero",
      "category": "zero_normalization",
      "input": -0.0,
      "expected_jcs": "0"
    },
    {
      "id": "integer_float_100",
      "category": "integer_float",
      "input": 100.0,
      "expected_jcs": "100"
    },
    {
      "id": "integer_float_neg42",
      "category": "integer_float",
      "input": -42.0,
      "expected_jcs": "-42"
    },
    {
      "id": "precision_double",
      "category": "precision",
      "input": 1.2345678901234567,
      "expected_jcs": "1.2345678901234567"
    },
    {
      "id": "subnormal_min",
      "category": "subnormal",
      "input": 5e-324,
      "expected_jcs": "5e-324"
    },
    {
      "id": "large_double_max",
      "category": "extrema",
      "input": 1.7976931348623157e+308,
      "expected_jcs": "1.7976931348623157e+308"
    },
    {
      "id": "shortest_repr_0_1",
      "category": "shortest_repr",
      "input": 0.1,
      "expected_jcs": "0.1"
    },
    {
      "id": "shortest_repr_0_2",
      "category": "shortest_repr",
      "input": 0.2,
      "expected_jcs": "0.2"
    },
    {
      "id": "utf16_key_sorting",
      "category": "key_ordering",
      "input": {
        "z": 1,
        "a": 2,
        "é": 3,
        "Ā": 4
      },
      "expected_jcs": "{\"a\":2,\"z\":1,\"é\":3,\"Ā\":4}"
    },
    {
      "id": "escaped_controls",
      "category": "string_escaping",
      "input": "quote: \" backslash: \\ newline: \n tab: \t",
      "expected_jcs": "\"quote: \\\" backslash: \\\\ newline: \\n tab: \\t\""
    },
    {
      "id": "utf16_surrogate_order_emoji_vs_bmp",
      "category": "utf16_surrogate_ordering",
      "input": {
        "😀": 1,
        "\uE000": 2
      },
      "expected_jcs": "{\"😀\":1,\"\":2}"
    },
    {
      "id": "utf16_surrogate_order_astral_vs_ffff",
      "category": "utf16_surrogate_ordering",
      "input": {
        "\uFFFF": 1,
        "𐀀": 2
      },
      "expected_jcs": "{\"𐀀\":2,\"￿\":1}"
    },
    {
      "id": "supplementary_unicode_deseret_vs_ethiopic",
      "category": "supplementary_unicode",
      "input": {
        "𐐷": 1,
        "ሴ": 2
      },
      "expected_jcs": "{\"ሴ\":2,\"𐐷\":1}"
    },
    {
      "id": "precision_max_safe_integer",
      "category": "precision_boundaries",
      "input": 9007199254740991.0,
      "expected_jcs": "9007199254740991"
    },
    {
      "id": "subnormal_min_normalized",
      "category": "extrema",
      "input": 2.2250738585072014e-308,
      "expected_jcs": "2.2250738585072014e-308"
    },
    {
      "id": "object_ordering_differential",
      "category": "object_ordering_differential",
      "input": {
        "b": {
          "2": 2,
          "1": 1
        },
        "a": [
          true,
          false,
          null
        ]
      },
      "expected_jcs": "{\"a\":[true,false,null],\"b\":{\"1\":1,\"2\":2}}"
    }
  ]
}
